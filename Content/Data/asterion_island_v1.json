  "dialogue": {
    "npc_mayor_elara": {
      "default": "Port Lyria keeps going, one delivery at a time. Come back when you have news.",
      "offer": "You're new on Asterion. Walk the harbor, meet Kael, then report back. That's how trust starts here.",
      "offer_trusted": "Good to see you again. Ridge Mine is running dry, and Northshore has gone quiet. Pick your work.",
      "in_progress": "The task isn't finished yet. The clinic is waiting.",
      "debrief_ready": "You're back. Tell me what happened out there.",
      "locked": "Not yet. The community needs to see more of you first.",
      "completed": "Asterion remembers who showed up when it mattered."
    },
    "npc_harbor_master": {
      "default": "The sea decides the schedule here, not me.",
      "offer": "Pinewatch is cut off again. Load water at Lyria and take the boat across when the weather allows.",
      "in_progress": "Ten packs for Pinewatch. The boat is at the dock when the port is open.",
      "debrief_ready": "Pinewatch radioed in. They got the water. Well done, captain.",
      "completed": "Fair winds. The ferry crews speak well of you.",
      "offer_trusted": "Pinewatch got its water. Now the reef: take Tidewatch down to the survey site and come back with a chart."
    },
    "npc_windfield_chief": {
      "default": "Windfield tower. Keep your approach slow and your cargo strapped.",
      "offer": "Beacon Clinic is short on medical packs. Load at Lyria, fly it over, land where the cross is painted.",
      "in_progress": "Four medical packs. The helicopter is fueled. Watch the wind.",
      "debrief_ready": "Clinic confirms receipt. Clean flight.",
      "completed": "You're on the Windfield roster now.",
      "offer_trusted": "We need eyes on the coast. Take the Skylark over Pinewatch and the reef, then bring her home."
    },
    "npc_clinic_nurse": {
      "default": "We make do. Every crate counts here.",
      "default_trusted": "The shelves look different since you started making runs. Thank you.",
      "offer": "Pinewatch has a casualty. Take the helicopter, land there, bring them straight here.",
      "in_progress": "Pinewatch first, then straight back here. Every minute counts.",
      "debrief_ready": "They're stable. You did that."
    },
    "npc_depot_mechanic": {
      "default": "The truck starts, which is more than I can say for most things on this island.",
      "offer": "Ridge Mine has parts we need. Take the tracked carrier — the road past the quarry eats trucks.",
      "in_progress": "Carrier handles like a barge. Take it slow on the climb.",
      "debrief_ready": "Six crates of parts. Depot's back in business.",
      "completed": "Anything with tracks, you're cleared to drive."
    },
    "npc_mine_foreman": {
      "default": "Pumps run, parts wear. We trade spare parts for water and food.",
      "debrief_ready": "Water's in the tanks. The crews thank you.",
      "completed": "The mine owes you one."
    },
    "npc_relief_coordinator": {
      "default": "The Network keeps talking to both sides. That is the whole job.",
      "offer": "The Commonwealth and the Pact need a room and a reason. Carry a message to Envoy Halden, then back to the Mayor.",
      "in_progress": "Halden first. Then the Mayor. Don't skip steps — this is fragile.",
      "locked": "Not yet. Both shores need to trust you before they'll listen.",
      "debrief_ready": "Both sides have agreed to talk. This changes everything.",
      "completed": "A new chapter. Keep the supplies moving while they argue."
    },
    "npc_northshore_envoy": {
      "default": "The Pact remembers who kept the strait open — and who didn't.",
      "offer": "Northshore stores are thin. Eight crates of food and we talk about more than weather.",
      "in_progress": "Eight crates. Cape Varn or the strip, either works.",
      "debrief_ready": "Received. Northshore remembers this.",
      "locked": "We have nothing to discuss yet.",
      "completed": "You have the Pact's ear."
    },
    "npc_cape_harbor": {
      "default": "Cape Varn. Watch the swell past the reef.",
      "offer": "Run the patrol: reef, then Pinewatch, then home. Fishing boats keep going missing out there.",
      "in_progress": "Reef first, then Pinewatch. Keep the radio on.",
      "debrief_ready": "Patrol logged. Nothing missing tonight.",
      "completed": "Cape Varn's log has your name in it."
    }
  },
  "terrain": {
    "notice": "Presentation-only terrain description (heights are placeholder gameplay geometry). Core positions use z = height above sea level.",
    "sea_level": 0.0,
